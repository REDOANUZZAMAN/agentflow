# ─── Supabase (Required) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── AI / LLM (At least one required) ───────────────────────────
# Option A: Anthropic direct (if not blocked in your region)
ANTHROPIC_API_KEY=sk-ant-...

# Option B: OpenRouter proxy (recommended for China/restricted regions)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# ─── fal.ai — Image / Video / Voice Generation (Required for workflows) ─
FAL_API_KEY=your_fal_api_key_here

# ─── Media storage (VPS disk, ffmpeg) ───────────────────────────
# Generated photos/videos/audio are saved here and served at /api/files/...
# PUBLIC_BASE_URL must be reachable from the internet (fal.ai fetches photos from it).
# ffmpeg + ffprobe must be installed on the server.
MEDIA_DIR=/var/lib/agentflow/media
PUBLIC_BASE_URL=http://your-server-ip:3010


# ─── Supabase Admin Scripts (Optional — for DB utility scripts) ─
# Only needed if you run deploy-schema.js or similar admin scripts
SUPABASE_ACCESS_TOKEN=sbp_your_access_token
SUPABASE_PROJECT_REF=your_project_ref
